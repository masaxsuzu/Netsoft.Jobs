@page "/"
@using Netsoft.Jobs.Contracts
@implements IDisposable
@inject JobBoard Board
@inject JobChangeFeed ChangeFeed

@* 画面は HTTP API（別プロセスの Web ホスト）を型付きクライアント越しに呼ぶ。
   状態と操作は JobBoard が持ち、ここは見せ方だけを持つ。分けてある理由は
   JobBoard の注記を参照（測れるようにするためと、回路なしで叩けるようにするため）。 *@

<h1>Netsoft.Jobs</h1>

@* プリレンダリング中（回路が繋がる前）の操作は失われる。@onsubmit は動かず素の
   フォーム送信になって入力ごと消えるし、押さなくても入力は回路の最初の描画で
   サーバ状態に巻き戻る。だから回路が繋がるまで入力とボタンを disabled にしておく。 *@
<section class="panel">
    <h2>Job の登録</h2>
    <form class="register" @onsubmit="RegisterAsync">
        <div class="field">
            <label for="job-name">名前</label>
            <input id="job-name" disabled="@(!_interactive)" @bind="Board.Name" />
            @foreach (string message in Board.ErrorsFor("name"))
            {
                <p class="error">@message</p>
            }
        </div>
        <div class="field">
            <label for="job-type">種類</label>
            @* 選択肢はサーバ（登録済みのハンドラ）から来る。ここに種類名を並べると、
               ハンドラを足し引きしたときに実行できる種類とずれる。 *@
            <select id="job-type" disabled="@(!_interactive || !Board.CanRegister)" @bind="Board.JobType">
                @* 既定を空にしておく。先頭の種類を勝手に選ぶと、選んだつもりのない
                   種類のまま登録できてしまう。 *@
                <option value="">選択してください</option>
                @foreach (JobTypeDto jobType in Board.JobTypes)
                {
                    <option value="@jobType.JobType">@jobType.JobType</option>
                }
            </select>
            @if (Board.JobTypesNotice is not null)
            {
                <p class="notice">@Board.JobTypesNotice</p>
            }
            @foreach (string message in Board.ErrorsFor("jobType"))
            {
                <p class="error">@message</p>
            }
        </div>
        <div class="field">
            <label for="job-parameters">パラメータ</label>
            @* 欄はテキスト 1 つのまま（Parameters はハンドラだけが解釈する不透明な文字列）。
               何を入れるのかの説明だけを、UI 側の対応表から選んだ種類に応じて出す。 *@
            <input id="job-parameters" disabled="@(!_interactive)" @bind="Board.Parameters"
                   placeholder="@JobParameterHints.For(Board.JobType)" />
            @foreach (string message in Board.ErrorsFor("parameters"))
            {
                <p class="error">@message</p>
            }
        </div>
        <button type="submit" class="primary"
                disabled="@(!_interactive || !Board.CanRegister || Board.IsBusy)">登録</button>
    </form>
</section>

<section class="panel">
    <h2>Job の一覧</h2>
    @if (Board.Notice is not null)
    {
        <p class="notice">@Board.Notice</p>
    }
    @if (Board.Jobs.Count == 0)
    {
        <p>Job はまだありません。</p>
    }
    else
    {
        <table>
            <thead>
                @* 見出しは短く。「作成日時」は列が時刻しか持たないので「作成」で足りる。
                   最後の列を空にしない ── 空の見出しは、そこに何が並ぶのかを読み手に推測させる。 *@
                <tr>
                    <th>名前</th>
                    <th>種類</th>
                    <th>状態</th>
                    <th>進捗</th>
                    <th>作成</th>
                    <th>開始</th>
                    <th>終了</th>
                    <th>失敗理由</th>
                    <th>パラメータ</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @* @key で行と Job を結びつける。無いと Blazor は行 DOM を「位置」で
                   再利用するので、新しい Job が入って行がずれたときに、まだ確定して
                   いない入力（レンダーツリーに乗っていない値）が別の Job の行へ移る。
                   その行で保存すると、打った値ではなくサーバ値が送られて何も保存されず、
                   それでも欄には打った文字が残る ── 画面が嘘をつく。 *@
                @foreach (JobListItemDto job in Board.Jobs)
                {
                    <tr @key="job.Id">
                        <td class="col-name">@job.Name</td>
                        <td class="col-type">@job.JobType</td>
                        <td><span class="badge @JobStatusLabel.ClassFor(job.Status)">@JobStatusLabel.From(job.Status)</span></td>
                        @* 帯と数字を両方出す。帯だけだと 3/4 と 30/40 が同じに見え、
                           数字だけだと一覧を眺めたときに進み具合を比べられない。 *@
                        <td class="progress">
                            @* 行がまだ無い Job に空の帯を出さない。0% の帯と「まだ分割されていない」は
                               別のことなので、同じ見た目にすると読み手が取り違える。 *@
                            @if (job.TotalSubTasks > 0)
                            {
                                <span class="bar"><span class="bar-fill" style="width:@(JobBoard.ProgressPercent(job))%"></span></span>
                            }
                            <span class="bar-text">@JobBoard.ProgressFor(job)</span>
                        </td>
                        @* 年は title に逃がす。3 列を 1 行に収めるために表示からは落としている。 *@
                        <td class="col-time" title="@JobBoard.FormatFull(job.CreatedAt)">@JobBoard.Format(job.CreatedAt)</td>
                        <td class="col-time" title="@JobBoard.FormatFull(job.StartedAt)">@JobBoard.Format(job.StartedAt)</td>
                        <td class="col-time" title="@JobBoard.FormatFull(job.FinishedAt)">@JobBoard.Format(job.FinishedAt)</td>
                        <td>@job.FailureMessage</td>
                        <td class="col-params">
                            @* 実行中でも編集できる（反映はサブタスクの境界）。入力中の値は
                               通知の再読み込みで消えないよう、行の再描画から独立に保持する。
                               get を辞書の indexer にしない。描画は変更通知や回路接続の合図で
                               いつでも走るので、ここで例外を出す式を書くと回路ごと死ぬ
                               （画面全体が二度と操作できなくなる）。get は常に値を返す形にする。 *@
                            <input class="edit-parameters"
                                   disabled="@(!_interactive || !job.CanEdit || Board.IsBusy)"
                                   @bind:get="Board.EditValueFor(job)"
                                   @bind:set="value => Board.SetEdit(job.Id, value)" />
                            <button type="button"
                                    disabled="@(!_interactive || !job.CanEdit || Board.IsBusy)"
                                    @onclick="() => Board.EditAsync(job.Id, CancellationToken.None)">
                                保存
                            </button>
                        </td>
                        <td class="col-actions">
                            @* 押せるかどうかはサーバが行に載せてくる。ここで状態名を並べて
                               判定すると、状態が増えたときに直し忘れたボタンができるし、
                               判定に要る規則は Domain のもので、画面は Domain を参照しない。
                               載っているのは行を受け取った瞬間の可否なので、押した先で状態が
                               進んでいれば拒否されうる（そのときは応答が現在の Job を返す）。
                               回路が繋がる前はそれ以前の問題として全部押せない（上の説明を参照）。 *@
                            <button type="button"
                                    disabled="@(!_interactive || !job.CanRequestPause || Board.IsBusy)"
                                    @onclick="() => Board.PauseAsync(job.Id, CancellationToken.None)">
                                一時停止
                            </button>
                            <button type="button"
                                    disabled="@(!_interactive || !job.CanRequestResume || Board.IsBusy)"
                                    @onclick="() => Board.ResumeAsync(job.Id, CancellationToken.None)">
                                再開
                            </button>
                            <button type="button" class="danger"
                                    disabled="@(!_interactive || !job.CanCancel || Board.IsBusy)"
                                    @onclick="() => Board.CancelAsync(job.Id, CancellationToken.None)">
                                キャンセル
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@* 押した操作が通らなかったことをここに出す。一覧の更新失敗（notice）と混ぜないのは、
   背景の変更通知で走る取り直しが成功した瞬間に消えてしまうため（JobBoard の注記を参照）。

   要素は開いていなくても DOM に置いたままにし、開閉は open 属性だけで切り替える。
   @if で囲うと、変更通知のたびに要素が作り直されて開き直しになる。
   showModal() を使わないのは JS interop を持ち込まないため（この repo にはまだ 1 つも無い）。
   モーダルにできない副作用として Esc では閉じないので、閉じる手段はボタンに置く。
   非モーダルであること自体は都合がよく、開いたまま裏の一覧が更新されていくのが見える。 *@
<dialog class="operation-dialog" open="@Board.IsOperationDialogOpen">
    <p>@Board.OperationError</p>
    <button type="button" @onclick="Board.CloseOperationDialog">閉じる</button>
</dialog>

@code {
    // 回路が繋がって操作がサーバに届くようになったか。プリレンダリング中は false のまま
    // 描画されるので、フォームは見えても disabled で押せない。
    private bool _interactive;

    // OnAfterRender はプリレンダリング中には呼ばれず、対話モードで動き始めて
    // 初めて呼ばれる。だから firstRender をそのまま「回路が繋がった」の合図に使える。
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // 読み込みより先に購読する。逆順だと、読み込みと再描画のすき間に起きた変更を取りこぼす。
        ChangeFeed.Changed += HandleChanged;

        await Board.InitializeAsync(CancellationToken.None);
    }

    public void Dispose() => ChangeFeed.Changed -= HandleChanged;

    private Task RegisterAsync() => Board.RegisterAsync(CancellationToken.None);

    /// <summary>
    /// 実行エンジンや他の画面が Job を変えたときに呼ばれる。
    /// </summary>
    private void HandleChanged()
    {
        // 発火元はエンジンや API のスレッドなので、必ずこの回路の同期コンテキストへ載せ替える。
        // 取り直し自体の失敗は Board が知らせに変えるので、ここで握るのは載せ替えと
        // 再描画の失敗だけ。通知の発火元（store の書き込み）へ例外を漏らさない。
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Board.ReloadAsync(CancellationToken.None);
                StateHasChanged();
            }
            catch (Exception)
            {
                // ここへ来るのは再描画そのものが壊れたときで、画面に出す先も残っていない。
            }
        });
    }
}
