@page "/"
@using Netsoft.Jobs.Contracts
@implements IDisposable
@inject JobsApiClient Api
@inject JobChangeFeed ChangeFeed

@* 画面は HTTP API（別プロセスの Web ホスト）を型付きクライアント越しに呼ぶ。
   ハンドラはもう同じプロセスに居ない。HTTP の形（400/404/409）はクライアントが
   結果型へ写すので、この画面はステータスコードを知らない。 *@

<h1>Netsoft.Jobs</h1>

@* プリレンダリング中（回路が繋がる前）の操作は失われる。@onsubmit は動かず素の
   フォーム送信になって入力ごと消えるし、押さなくても入力は回路の最初の描画で
   サーバ状態に巻き戻る。だから回路が繋がるまで入力とボタンを disabled にしておく。 *@
<section>
    <h2>Job の登録</h2>
    <form @onsubmit="RegisterAsync">
        <div>
            <label for="job-name">名前</label>
            <input id="job-name" disabled="@(!_interactive)" @bind="_name" />
            @foreach (string message in ErrorsFor("name"))
            {
                <p class="error">@message</p>
            }
        </div>
        <div>
            <label for="job-type">種類</label>
            @* 選択肢はサーバ（登録済みのハンドラ）から来る。ここに種類名を並べると、
               ハンドラを足し引きしたときに実行できる種類とずれる。 *@
            <select id="job-type" disabled="@(!_interactive || !CanRegister)" @bind="_jobType">
                @* 既定を空にしておく。先頭の種類を勝手に選ぶと、選んだつもりのない
                   種類のまま登録できてしまう。 *@
                <option value="">選択してください</option>
                @foreach (JobTypeDto jobType in _jobTypes)
                {
                    <option value="@jobType.JobType">@jobType.JobType</option>
                }
            </select>
            @if (_jobTypesNotice is not null)
            {
                @* 一覧の _notice と分けてあるのは、この知らせが「登録できない理由」であり、
                   一覧の操作（キャンセル）の結果で消えてはいけないため。 *@
                <p class="notice">@_jobTypesNotice</p>
            }
            @foreach (string message in ErrorsFor("jobType"))
            {
                <p class="error">@message</p>
            }
        </div>
        <div>
            <label for="job-parameters">パラメータ</label>
            @* 欄はテキスト 1 つのまま（Parameters はハンドラだけが解釈する不透明な文字列）。
               何を入れるのかの説明だけを、UI 側の対応表から選んだ種類に応じて出す。 *@
            <input id="job-parameters" disabled="@(!_interactive)" @bind="_parameters" placeholder="@JobParameterHints.For(_jobType)" />
            @foreach (string message in ErrorsFor("parameters"))
            {
                <p class="error">@message</p>
            }
        </div>
        <button type="submit" disabled="@(!_interactive || !CanRegister)">登録</button>
    </form>
</section>

<section>
    <h2>Job の一覧</h2>
    @if (_notice is not null)
    {
        <p class="notice">@_notice</p>
    }
    @if (_jobs.Count == 0)
    {
        <p>Job はまだありません。</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>名前</th>
                    <th>種類</th>
                    <th>状態</th>
                    <th>進捗</th>
                    <th>作成日時</th>
                    <th>開始日時</th>
                    <th>終了日時</th>
                    <th>失敗理由</th>
                    <th>パラメータ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (JobDto job in _jobs)
                {
                    <tr>
                        <td>@job.Name</td>
                        <td>@job.JobType</td>
                        <td>@job.Status</td>
                        @* サブタスクの進捗（完了 / 総数）。行がまだ無い（登録直後）は「-」。
                           個々の状態まで並べるほどの幅は無いので、数字だけを出す。 *@
                        <td class="progress">@ProgressFor(job.Id)</td>
                        <td>@Format(job.CreatedAt)</td>
                        <td>@Format(job.StartedAt)</td>
                        <td>@Format(job.FinishedAt)</td>
                        <td>@job.FailureMessage</td>
                        <td>
                            @* 実行中でも編集できる（反映はサブタスクの境界）。入力中の値は
                               通知の再読み込みで消えないよう、行の再描画から独立に保持する。
                               get を辞書の indexer にしない。描画は変更通知や回路接続の合図で
                               いつでも走るので、ここで例外を出す式を書くと回路ごと死ぬ
                               （画面全体が二度と操作できなくなる）。get は常に値を返す形にする。 *@
                            <input class="edit-parameters"
                                   disabled="@(!_interactive || !JobEditability.CanEdit(job))"
                                   @bind:get="EditValueFor(job)"
                                   @bind:set="value => _edits[job.Id] = value ?? string.Empty" />
                            <button type="button"
                                    disabled="@(!_interactive || !JobEditability.CanEdit(job))"
                                    @onclick="() => EditAsync(job.Id)">
                                保存
                            </button>
                        </td>
                        <td>
                            @* 押せるかどうかは Domain の状態機械に聞く。ここで状態名を並べて
                               判定すると、状態が増えたときに直し忘れたボタンができる。
                               回路が繋がる前はそれ以前の問題として全部押せない（上の説明を参照）。 *@
                            <button type="button"
                                    disabled="@(!_interactive || !JobPausability.CanRequestPause(job))"
                                    @onclick="() => PauseAsync(job.Id)">
                                一時停止
                            </button>
                            <button type="button"
                                    disabled="@(!_interactive || !JobPausability.CanRequestResume(job))"
                                    @onclick="() => ResumeAsync(job.Id)">
                                再開
                            </button>
                            <button type="button"
                                    disabled="@(!_interactive || !JobCancelability.CanRequestCancel(job))"
                                    @onclick="() => CancelAsync(job.Id)">
                                キャンセル
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private IReadOnlyList<JobDto> _jobs = [];
    private IReadOnlyList<JobTypeDto> _jobTypes = [];
    private readonly Dictionary<string, IReadOnlyList<SubTaskDto>> _subTasks = [];
    private readonly Dictionary<string, string> _edits = [];
    private IDictionary<string, string[]> _registrationErrors = new Dictionary<string, string[]>();
    private string? _notice;
    private string? _jobTypesNotice;

    // 選べる種類が 1 つも無い状態で登録させない。押しても種類が空で必ず弾かれるだけで、
    // 利用者にはどうしようもない（種類は自分では入力できない）。
    private bool CanRegister => _jobTypes.Count > 0;

    private string _name = string.Empty;
    private string _jobType = string.Empty;
    private string _parameters = string.Empty;

    // 回路が繋がって操作がサーバに届くようになったか。プリレンダリング中は false のまま
    // 描画されるので、フォームは見えても disabled で押せない。
    private bool _interactive;

    // OnAfterRender はプリレンダリング中には呼ばれず、対話モードで動き始めて
    // 初めて呼ばれる。だから firstRender をそのまま「回路が繋がった」の合図に使える。
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // 読み込みより先に購読する。逆順だと、読み込みと再描画のすき間に起きた変更を取りこぼす。
        ChangeFeed.Changed += HandleChanged;

        await LoadJobTypesAsync();
        await LoadAsync();
    }

    public void Dispose() => ChangeFeed.Changed -= HandleChanged;

    /// <summary>
    /// 実行エンジンや他の画面が Job を変えたときに呼ばれる。
    /// </summary>
    private void HandleChanged()
    {
        // 発火元はエンジンや API のスレッドなので、必ずこの回路の同期コンテキストへ載せ替える。
        // 例外を出すと通知の発火元（store の書き込み）へ漏れるため、ここで握って表示に変える。
        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadAsync();
                StateHasChanged();
            }
            catch (Exception exception)
            {
                _notice = $"一覧の更新に失敗しました: {exception.Message}";
                StateHasChanged();
            }
        });
    }

    private async Task LoadAsync()
    {
        _jobs = await Api.ListJobsAsync(CancellationToken.None);

        foreach (JobDto job in _jobs)
        {
            // 404（読んでいる間に消えた）は「行なし」と同じ扱いでよい。
            _subTasks[job.Id] = await Api.ListSubTasksAsync(job.Id, CancellationToken.None) ?? [];
        }
    }

    /// <summary>
    /// 編集欄に出す値。入力中の値があればそれを、無ければサーバの現在値を出す。
    /// </summary>
    /// <remarks>
    /// _edits は「利用者が打った値」だけを持ち、読み込みでの種まきをしない。
    /// 種まき方式だと、_jobs の差し替えと種まきの間に描画が走った瞬間に
    /// 辞書の取りこぼしが起きる（描画は await のたびに割り込める）。
    /// </remarks>
    private string EditValueFor(JobDto job) =>
        _edits.TryGetValue(job.Id, out string? edited) ? edited : job.Parameters;

    private string ProgressFor(string id)
    {
        if (!_subTasks.TryGetValue(id, out IReadOnlyList<SubTaskDto>? subTasks) || subTasks.Count == 0)
        {
            return "-";
        }

        int completed = subTasks.Count(subTask => subTask.Status == "Completed");
        return $"{completed}/{subTasks.Count}";
    }

    /// <summary>
    /// 選択肢に出す種類を取り直す。
    /// </summary>
    /// <remarks>
    /// 失敗しても画面ごと落とさない。種類が取れないのは登録できないというだけで、
    /// 一覧は見えるべきだし、API が戻れば次の読み込みで選べるようになる。
    /// 例外の型を絞らないのは、ここで区別しても利用者への伝え方が変わらないため
    /// （繋がらない・5xx・壊れた応答のいずれも「取得できなかった」に落ちる）。
    /// </remarks>
    private async Task LoadJobTypesAsync()
    {
        try
        {
            _jobTypes = await Api.ListJobTypesAsync(CancellationToken.None);
            _jobTypesNotice = _jobTypes.Count == 0
                ? "登録できる Job の種類がありません。"
                : null;
        }
        catch (Exception exception)
        {
            _jobTypes = [];
            _jobTypesNotice = $"Job の種類を取得できませんでした: {exception.Message}";
        }
    }

    private async Task RegisterAsync()
    {
        RegisterJobResponse result = await Api.RegisterJobAsync(
            _name, _jobType, _parameters, CancellationToken.None);

        if (!result.IsSuccess)
        {
            // API の 400（ValidationProblem）の errors がそのまま項目ごとの表示に使える形。
            _registrationErrors = result.Errors;
            return;
        }

        _registrationErrors = new Dictionary<string, string[]>();
        _name = string.Empty;
        _jobType = string.Empty;
        _parameters = string.Empty;

        // 一覧は store の変更通知でも更新されるが、自分の操作の結果は通知を待たずに反映する。
        await LoadAsync();
    }

    private async Task PauseAsync(string id)
    {
        JobControlResponse result = await Api.PauseJobAsync(id, CancellationToken.None);

        _notice = result switch
        {
            { Job: null } => "対象の Job が見つかりませんでした。",
            { IsSuccess: false } => $"一時停止できませんでした。現在の状態: {result.Job.Status}",
            _ => null,
        };

        await LoadAsync();
    }

    private async Task ResumeAsync(string id)
    {
        JobControlResponse result = await Api.ResumeJobAsync(id, CancellationToken.None);

        _notice = result switch
        {
            { Job: null } => "対象の Job が見つかりませんでした。",
            { IsSuccess: false } => $"再開できませんでした。現在の状態: {result.Job.Status}",
            _ => null,
        };

        await LoadAsync();
    }

    private async Task EditAsync(string id)
    {
        // 打っていなければ欄にはサーバ値が出ているので、それをそのまま送る（実質の無変更）。
        string parameters = _edits.TryGetValue(id, out string? edited)
            ? edited
            : _jobs.FirstOrDefault(job => job.Id == id)?.Parameters ?? string.Empty;
        EditJobResponse result = await Api.EditJobParametersAsync(id, parameters, CancellationToken.None);

        _notice = result switch
        {
            { IsSuccess: true } => null,
            { Errors.Count: > 0 } => $"編集できませんでした: {result.Errors.Values.SelectMany(m => m).FirstOrDefault()}",
            { Job: null } => "対象の Job が見つかりませんでした。",
            _ => $"編集できませんでした。現在の状態: {result.Job.Status}",
        };

        if (result.IsSuccess)
        {
            // 入力中の値を破棄して、欄をサーバの現在値（受理された形）へ戻す。
            _edits.Remove(id);
        }

        await LoadAsync();
    }

    private async Task CancelAsync(string id)
    {
        CancelJobResponse result = await Api.CancelJobAsync(id, CancellationToken.None);

        // 拒否は誤りではなく「ボタンを出した後に状態が進んだ」競合。現在の状態を見せて説明する。
        _notice = result switch
        {
            { Job: null } => "対象の Job が見つかりませんでした。",
            { IsSuccess: false } => $"キャンセルできませんでした。現在の状態: {result.Job.Status}",
            _ => null,
        };

        await LoadAsync();
    }

    private IEnumerable<string> ErrorsFor(string field) =>
        _registrationErrors.TryGetValue(field, out string[]? messages) ? messages : [];

    private static string Format(DateTimeOffset? value) =>
        value is { } present ? present.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") : "-";
}
