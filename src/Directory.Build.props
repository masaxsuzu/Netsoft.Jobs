<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    src 配下のプロジェクト名は短く保ち、Netsoft.Jobs の prefix はここで付ける。
    ディレクトリ名を変えれば名前空間も追随するので、二重管理が起きない。
  -->
  <PropertyGroup>
    <AssemblyName>Netsoft.Jobs.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Netsoft.Jobs.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!--
    doc コメントを検査対象にする。src には <see cref="..."/> が 246 個あり、
    これを立てるまでは**全部が「壊れても誰も気付かない参照」**だった。
    親の TreatWarningsAsErrors により CS1574（解決できない cref）と
    CS1573（param の付け漏れ）がビルドを落とす。

    実際に腐っていた。#80 で Contracts から Domain 参照を切ったとき、
    Ui の <see cref="Domain.Job.Parameters"/> は指す先を失ったのに build も test も通っていた。
    コメントだけがゲートの外にあり、このリポジトリで唯一「機械が見ていない成果物」だった。

    1591（public に doc が無い）は落とさない。doc を義務にすると、
    識別子を言い換えるだけの <summary> が増える ── docs/conventions.md が
    禁じている「How をなぞるコメント」そのものを、量産する圧力になる。
    **書くかどうかは書き手が決め、書いたものは機械が検査する**、という線を引いている。

    tests 側には入れていない。検査したいのは src の設計ログで、
    テストの What はテスト名が担っている。
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!--
    自前のアナライザー。今は「排他を使わない」(NJ0001) の 1 本だけで、
    親の TreatWarningsAsErrors によりビルドを落とす。

    掛けるのは src/ だけ。tests/ の並行ハーネスは重なりを故意に作る道具で、
    そこの排他は検証の一部なので禁じる相手ではない。

    ReferenceOutputAssembly=false が要る。付けないと Roslyn への入力としてだけでなく
    参照アセンブリとしても混ざり、src/ が netstandard2.0 のこれを抱えることになる。
  -->
  <ItemGroup>
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)../tools/analyzers/Analyzers/Analyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
