<?xml version="1.0" encoding="utf-8"?>
<!--
  カバレッジ計測の設定。CI と scripts/coverage.sh が使う。

  除外の方針: 「テストを書けるのに書いていない」を隠す除外はしない。
  除外してよいのは、E2E が実プロセスで検証しているが coverlet の仕組み上
  計測に乗らないものだけ。
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- テストコード自身は計測対象外 -->
          <Exclude>[*.Tests]*</Exclude>
          <!--
            Razor コンポーネントのイベントハンドラは回路 (WebSocket) 経由でしか
            動かず、E2E が実ブラウザで検証している。E2E はアプリを別プロセスで
            起動するため coverlet では計測できない。
          -->
          <ExcludeByFile>**/*.razor</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
